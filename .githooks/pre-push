#!/bin/sh
# push 차단 규칙 2개 — main 직접 push, 그리고 히스토리 덮어쓰기(force push).
#
# ⚠️ 규칙을 문서로만 뒀다가 실제로 어겨져서(화면 5장이 main 에 직접 올라감) 훅으로 강제한다.
# ⚠️ force push 는 남의 커밋을 조용히 지운다. 팀장이 자기 브랜치에서 했다가
#    GitHub 워크플로 이벤트가 유실돼 CI 가 아예 안 도는 일도 겪었다.
#
# git 은 --force 여부를 인자로 알려주지 않는다(인자는 "origin <url>" 뿐).
# 대신 stdin 으로 넘어오는 <local sha> <remote sha> 를 비교해 판단한다:
#   remote_sha 가 local_sha 의 조상이 아니면 → 히스토리를 덮어쓰는 push

PROTECTED="main"
ZERO="0000000000000000000000000000000000000000"

BLOCKED_MAIN=0
FORCED=0
FORCED_REF=""

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  # main 직접 push
  if [ "$remote_ref" = "refs/heads/$PROTECTED" ]; then
    BLOCKED_MAIN=1
  fi

  # 새 브랜치($remote_sha=0)나 브랜치 삭제($local_sha=0)는 검사 대상이 아니다
  if [ "$remote_sha" != "$ZERO" ] && [ "$local_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      FORCED=1
      FORCED_REF="${remote_ref#refs/heads/}"
    fi
  fi
done

if [ "$FORCED" -eq 1 ]; then
  cat >&2 <<MSG

❌ 히스토리를 덮어쓰는 push 입니다 (force / non-fast-forward).

  브랜치: $FORCED_REF

  원격에 있던 커밋이 사라집니다. 혼자 쓰는 브랜치라도 CI 이벤트가 유실돼
  검사가 아예 안 도는 일이 있습니다.

  되돌릴 게 있으면 새 커밋으로 되돌리세요:

    git revert <되돌릴-커밋>
    git push

  원격 변경을 먼저 받아야 하는 상황이면:

    git fetch origin && git merge origin/$FORCED_REF

  ⚠️ 정말 예외가 필요하면 팀장과 상의 후 --no-verify 를 씁니다.

MSG
  exit 1
fi

if [ "$BLOCKED_MAIN" -eq 1 ]; then
  CURRENT="$(git rev-parse --abbrev-ref HEAD)"
  cat >&2 <<MSG

❌ main 에 직접 push 할 수 없습니다.

  현재 브랜치: $CURRENT

  흐름 단위 브랜치 → PR → 팀장 머지 순서로 가세요:

    git switch -c feat/화면이름
    git push -u origin feat/화면이름
    gh pr create              (또는 GitHub 웹에서 PR 생성)

  브랜치 이름은 CLAUDE.md 분담표를 따릅니다
  (feat/s1-main · feat/claim-flow · feat/s3-* 등).

MSG
  exit 1
fi

exit 0
