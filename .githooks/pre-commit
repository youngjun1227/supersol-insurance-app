#!/bin/sh
# 1) 커밋 작성자 확인
EMAIL="$(git config user.email)"
case "$EMAIL" in
  *anthropic.com*) echo "❌ user.email 이 anthropic 도메인입니다. 본인 이메일로 설정하세요." >&2; exit 1;;
esac

# 2) 토큰 규칙 lint — 스테이징된 src 파일만 검사
STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '^src/.*\.(css|tsx|ts)$' || true)"
if [ -n "$STAGED" ]; then
  if command -v node >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    node scripts/lint-tokens.mjs $STAGED || {
      echo "" >&2
      echo "커밋을 중단했습니다. 위 항목을 고치고 다시 커밋하세요." >&2
      echo "정말 예외가 필요하면 팀장과 상의 후 --no-verify 를 쓰세요." >&2
      exit 1
    }
  else
    echo "⚠️  node 를 찾을 수 없어 토큰 lint 를 건너뜁니다." >&2
  fi
fi

# 3) 문구 규칙 — 금칙어·실명·실번호
# ⚠️ public 저장소라 실명은 push 후에 잡으면 이미 늦다. CI 에도 같은 검사가 있지만
#    커밋 시점에 한 번 더 막는다 (#108). 스테이징된 코드·문서만 본다.
STAGED_COPY="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|css|html|md)$' || true)"
if [ -n "$STAGED_COPY" ]; then
  if command -v node >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    node scripts/check-copy.mjs $STAGED_COPY || {
      echo "" >&2
      echo "커밋을 중단했습니다. 문구 규칙은 CLAUDE.md 를 보세요." >&2
      exit 1
    }
  fi
fi

# 4) 목데이터 정합성 — 원본 문서와 어긋나면 막는다
if git diff --cached --name-only --diff-filter=ACM | grep -q '^src/data/mock\.ts$'; then
  if command -v node >/dev/null 2>&1; then
    node scripts/check-mock.mjs || {
      echo "" >&2
      echo "커밋을 중단했습니다. 목데이터는 임의로 바꾸지 않습니다." >&2
      exit 1
    }
  fi
fi

exit 0
